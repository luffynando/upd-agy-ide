#!/usr/bin/env bash
# Instala y actualiza Antigravity IDE en Debian/Ubuntu y derivadas.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	echo "Run with sudo: sudo $(basename "$0")" >&2
	exit 1
fi

# -------------------------------------------------------------
# Configuración
# -------------------------------------------------------------
download_page="https://antigravity.google/releases"
fallback_api_url="https://antigravity-ide-auto-updater-974169037036.us-central1.run.app/releases"
install_root="/opt/antigravity-ide"
install_dir="Antigravity-IDE"
archive_top_dir="Antigravity IDE"
command_link="/usr/local/bin/antigravity-ide"
cli_link="/usr/local/bin/agy-ide"
updater_bin="/usr/local/bin/upd-agy-ide"
legacy_updater_bin="/usr/local/bin/update-antigravity-ide"
desktop_file="/usr/share/applications/antigravity-ide.desktop"
icon_file="/usr/share/icons/hicolor/512x512/apps/antigravity-ide.png"
apparmor_file="/etc/apparmor.d/antigravity-ide"

# Librerías de Electron: las de la primera lista usan sufijo t64 en distros modernas
libs_t64=(libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcups2 libglib2.0-0 libgtk-3-0)
libs_plain=(
	libcairo2 libdbus-1-3 libdrm2 libgbm1 libnspr4 libnss3 libpango-1.0-0 libx11-6
	libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2
)

case "$(uname -m)" in
x86_64 | amd64) platform="linux-x64" ;;
aarch64 | arm64) platform="linux-arm" ;;
*)
	echo "Unsupported architecture: $(uname -m)" >&2
	exit 1
	;;
esac

# -------------------------------------------------------------
# Detección del sistema operativo
# Soporte: Ubuntu 22.04/24.04/26.04, Debian 12/13 y derivados
# -------------------------------------------------------------
os_id="unknown"
os_version_id=""
os_codename=""
os_pretty="Linux"
has_t64=no
needs_apparmor=no

if [ -f /etc/os-release ]; then
	# shellcheck source=/dev/null
	. /etc/os-release
	os_id="${ID:-unknown}"
	os_version_id="${VERSION_ID:-}"
	os_codename="${VERSION_CODENAME:-}"
	os_pretty="${PRETTY_NAME:-$os_id}"
fi

major_ver="${os_version_id%%.*}"
case "$os_id" in
ubuntu)
	if [ "${major_ver:-0}" -ge 24 ] 2>/dev/null; then has_t64=yes; fi
	;;
debian)
	if [ "${major_ver:-0}" -ge 13 ] 2>/dev/null ||
		[ "$os_codename" = "trixie" ] || [ "$os_codename" = "sid" ] || [ "$os_codename" = "forky" ]; then
		has_t64=yes
	fi
	;;
*)
	# Derivadas (Linux Mint, Pop!_OS, PikaOS, etc.)
	if command -v apt-cache >/dev/null 2>&1 && apt-cache show libgtk-3-0t64 >/dev/null 2>&1; then
		has_t64=yes
	fi
	;;
esac

# AppArmor puede restringir userns no privilegiados (Ubuntu 24.04+, Debian con restricción)
if [ -d /etc/apparmor.d ] &&
	{ [ -f /etc/apparmor.d/abi/4.0 ] ||
		[ "$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || echo 0)" = "1" ]; }; then
	needs_apparmor=yes
fi

printf 'Sistema operativo detectado: %s (ID: %s, Versión: %s, Codename: %s)\n' \
	"$os_pretty" "$os_id" "${os_version_id:-N/A}" "${os_codename:-N/A}"

# -------------------------------------------------------------
# Utilidades
# -------------------------------------------------------------
apt_install() {
	export DEBIAN_FRONTEND=noninteractive
	apt-get update -qq
	apt-get install -y -qq --no-install-recommends "$@"
}

remove_previous_backup() {
	if [ -d "${install_root}.previous" ]; then
		rm -rf "${install_root}.previous"
		printf 'Respaldo previo eliminado: %s\n' "${install_root}.previous"
	fi
}

# Herramientas básicas que pueden faltar en instalaciones mínimas
missing_cmds=()
for required_command in curl tar python3; do
	command -v "$required_command" >/dev/null 2>&1 || missing_cmds+=("$required_command")
done

if [ "${#missing_cmds[@]}" -gt 0 ]; then
	if command -v apt-get >/dev/null 2>&1; then
		echo "Installing required tools (${missing_cmds[*]})..."
		apt_install ca-certificates "${missing_cmds[@]}"
	else
		echo "Missing required commands: ${missing_cmds[*]}" >&2
		exit 1
	fi
fi

# Migración del script antiguo (update-antigravity-ide) al nuevo (upd-agy-ide)
if [ -e "$legacy_updater_bin" ] || [ -L "$legacy_updater_bin" ]; then
	script_self=$(readlink -f "$0" 2>/dev/null || echo "$0")
	if [ ! -e "$updater_bin" ] && [ -f "$script_self" ]; then
		install -m 0755 "$script_self" "$updater_bin"
		printf 'Script de actualización migrado: %s -> %s\n' "$legacy_updater_bin" "$updater_bin"
	fi
	rm -f "$legacy_updater_bin"
	printf 'Script obsoleto eliminado: %s\n' "$legacy_updater_bin"
fi

# Ruta real de instalación (resuelve enlaces simbólicos)
resolved_install_root=$(readlink -f "$install_root" || echo "$install_root")

# El enlace de comando existente debe apuntar a esta instalación
if [ -L "$command_link" ]; then
	command_target=$(readlink -f "$command_link" || true)
	case "$command_target" in
	"$resolved_install_root"/* | "$install_root"/*) ;;
	*)
		echo "$command_link points to $command_target. Move it before rerunning this helper." >&2
		exit 1
		;;
	esac
elif [ -e "$command_link" ]; then
	echo "$command_link exists and is not a symlink. Move it before rerunning this helper." >&2
	exit 1
fi

tmp_parent="${TMPDIR:-/var/tmp}"
mkdir -p "$tmp_parent"
tmpdir=$(mktemp -d "$tmp_parent/antigravity-ide.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT
download_html="$tmpdir/download.html"
archive="$tmpdir/Antigravity-IDE.tar.gz"
archive_list="$tmpdir/archive-list.txt"

# -------------------------------------------------------------
# Consulta de la última versión disponible
# -------------------------------------------------------------
curl -fsSL --compressed --retry 3 -o "$download_html" "$download_page" || true

download_fields=$(
	python3 - "$download_html" "$download_page" "$platform" "$fallback_api_url" <<'PY'
import json
import re
import sys
import urllib.request
from pathlib import Path
from urllib.parse import urljoin

html_path = Path(sys.argv[1])
page_url = sys.argv[2]
platform = sys.argv[3]
fallback_api_url = sys.argv[4]

html = html_path.read_text(errors="replace") if html_path.is_file() else ""

base_match = re.search(r'<base\s+href="([^"]+)"', html)
base_url = urljoin(page_url, base_match.group(1)) if base_match else page_url

api_pattern = re.compile(r'https://antigravity-ide-auto-updater[a-zA-Z0-9.-]*/releases')
api_url = None

# 1. URL de la API directamente en el HTML
direct_match = api_pattern.search(html)
if direct_match:
    api_url = direct_match.group(0)

# 2. Bundles JS referenciados (en orden inverso: los scripts principales cargan al final)
if not api_url and html:
    seen = set()
    for js_rel in reversed(re.findall(r'(?:src|href)="([^"]*\.js)"', html)):
        js_url = urljoin(base_url, js_rel)
        if js_url in seen:
            continue
        seen.add(js_url)
        try:
            req = urllib.request.Request(js_url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                bundle = resp.read().decode("utf-8", errors="replace")
        except Exception:
            continue
        m = api_pattern.search(bundle)
        if m:
            api_url = m.group(0)
            break

# 3. Endpoint conocido como respaldo
api_url = api_url or fallback_api_url

try:
    req = urllib.request.Request(api_url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as response:
        releases = json.loads(response.read().decode("utf-8"))
except Exception as e:
    raise SystemExit(f"Failed to fetch releases from API ({api_url}): {e}")

if not releases or not isinstance(releases, list):
    raise SystemExit("Invalid releases format received from API")

latest = releases[0]
version = latest.get("version")
exec_id = latest.get("execution_id")

if not version or not exec_id:
    raise SystemExit("Latest release missing version or execution_id")

print(version, f"https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/{version}-{exec_id}/{platform}/Antigravity%20IDE.tar.gz")
PY
)
read -r version download_url <<<"$download_fields"

if [ -z "$version" ] || [ -z "$download_url" ]; then
	echo "Could not parse the Antigravity IDE download page." >&2
	exit 1
fi

# -------------------------------------------------------------
# Estado de la instalación actual
# -------------------------------------------------------------
install_path="$resolved_install_root/$install_dir"
expected_target="$install_path/antigravity-ide"
sandbox_path="$install_path/chrome-sandbox"
product_json="$install_path/resources/app/product.json"
installed_version=$(cat "$resolved_install_root/.linuxcapable-version" 2>/dev/null || true)

# Respaldo: leer ideVersion de product.json si falta el archivo de versión
if [ -z "$installed_version" ] && [ -f "$product_json" ]; then
	installed_version=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("ideVersion", ""))' "$product_json" 2>/dev/null || true)
fi

is_update=no
if [ -n "$installed_version" ] || [ -d "$install_path" ]; then
	is_update=yes
fi

desktop_matches=no
if [ -f "$desktop_file" ] &&
	grep -q '^Icon=antigravity-ide$' "$desktop_file" &&
	grep -q '^StartupWMClass=antigravity-ide$' "$desktop_file"; then
	desktop_matches=yes
fi

apparmor_matches=yes
if [ "$needs_apparmor" = yes ] &&
	{ [ ! -f "$apparmor_file" ] || ! grep -Fq "$expected_target" "$apparmor_file"; }; then
	apparmor_matches=no
fi

sandbox_ok=no
if [ ! -e "$sandbox_path" ] || [ "$(stat -c '%U:%G:%a' "$sandbox_path")" = "root:root:4755" ]; then
	sandbox_ok=yes
fi

if [ "$installed_version" = "$version" ] &&
	[ -x "$expected_target" ] &&
	[ -L "$command_link" ] &&
	[ "$(readlink -f "$command_link")" = "$expected_target" ] &&
	[ -L "$cli_link" ] &&
	[ "$desktop_matches" = yes ] &&
	[ "$apparmor_matches" = yes ] &&
	[ -f "$icon_file" ] &&
	[ "$sandbox_ok" = yes ]; then
	remove_previous_backup
	printf 'Antigravity IDE %s is already installed at %s (versión más reciente)\n' "$version" "$install_path"
	exit 0
fi

if [ "$is_update" = yes ]; then
	printf 'Instalación existente detectada: Antigravity IDE %s en %s\n' "${installed_version:-desconocida}" "$install_path"
	if [ "$installed_version" = "$version" ]; then
		printf 'Misma versión (%s): se repararán los componentes faltantes.\n' "$version"
	else
		printf 'Nueva versión disponible: se actualizará %s -> %s\n' "${installed_version:-desconocida}" "$version"
	fi
else
	printf 'No se detectó instalación previa. Se instalará Antigravity IDE %s.\n' "$version"
fi

# -------------------------------------------------------------
# Descarga y validación del paquete
# -------------------------------------------------------------
printf 'Downloading Antigravity IDE %s for %s...\n' "$version" "$platform"
curl -fsSL --retry 3 -o "$archive" "$download_url"
tar -tzf "$archive" >"$archive_list"
top_dir=$(sed -n '1{s#/.*##;p;q}' "$archive_list")
if [ "$top_dir" != "$archive_top_dir" ]; then
	echo "Unexpected archive directory: $top_dir" >&2
	exit 1
fi

tar -xzf "$archive" -C "$tmpdir"
extracted="$tmpdir/$archive_top_dir"
if [ ! -x "$extracted/antigravity-ide" ]; then
	echo "The Antigravity IDE launcher was not found in the archive." >&2
	exit 1
fi

icon_source="$extracted/resources/app/resources/linux/code.png"
if [ ! -f "$icon_source" ]; then
	echo "The Antigravity IDE icon was not found in the archive." >&2
	exit 1
fi

# Instalamos las librerías de Electron que falten según la distribución detectada
if command -v ldd >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1 &&
	ldd "$extracted/antigravity-ide" 2>/dev/null | grep -q "not found"; then
	echo "Installing missing system libraries for $os_pretty..."
	lib_suffix=""
	[ "$has_t64" = yes ] && lib_suffix="t64"
	pkgs=("${libs_plain[@]}")
	for lib in "${libs_t64[@]}"; do
		pkgs+=("$lib$lib_suffix")
	done
	apt_install "${pkgs[@]}" || true
fi

# -------------------------------------------------------------
# Instalación (reemplazo atómico del directorio)
# -------------------------------------------------------------
rm -rf "${install_root}.new"
mkdir -p "${install_root}.new/$install_dir"
cp -a "$extracted/." "${install_root}.new/$install_dir/"
printf '%s\n' "$version" >"${install_root}.new/.linuxcapable-version"
if [ -f "${install_root}.new/$install_dir/chrome-sandbox" ]; then
	chown root:root "${install_root}.new/$install_dir/chrome-sandbox"
	chmod 4755 "${install_root}.new/$install_dir/chrome-sandbox"
fi
if [ -d "$install_root" ]; then
	rm -rf "${install_root}.previous"
	mv "$install_root" "${install_root}.previous"
fi
mv "${install_root}.new" "$install_root"

# Ruta real tras mover el directorio
resolved_install_root=$(readlink -f "$install_root" || echo "$install_root")
install_path="$resolved_install_root/$install_dir"
real_binary="$install_path/antigravity-ide"

ln -sfn "$real_binary" "$command_link"

# Instalación exitosa: el respaldo previo ya no es necesario
if [ -x "$real_binary" ]; then
	remove_previous_backup
fi

# Perfil de AppArmor (permite userns para el sandbox de Chromium/Electron)
if [ "$needs_apparmor" = yes ]; then
	abi_directive=""
	[ -f /etc/apparmor.d/abi/4.0 ] && abi_directive="abi <abi/4.0>,"

	tee "$apparmor_file" >/dev/null <<APPARMOR
# This profile allows everything and only exists to give the
# application a name instead of having the label "unconfined"

$abi_directive
include <tunables/global>

profile antigravity-ide $real_binary flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/antigravity-ide>
}
APPARMOR
	if command -v apparmor_parser >/dev/null 2>&1; then
		apparmor_parser -r "$apparmor_file" >/dev/null 2>&1 || true
	fi
fi

# Icono y acceso directo de escritorio
mkdir -p "$(dirname "$icon_file")"
install -m 0644 "$icon_source" "$icon_file"

tee "$desktop_file" >/dev/null <<DESKTOP
[Desktop Entry]
Name=Antigravity IDE
Comment=Google Antigravity IDE
Exec=$command_link %U
Icon=antigravity-ide
Terminal=false
Type=Application
Categories=Development;IDE;
MimeType=x-scheme-handler/antigravity-ide;application/x-antigravity-workspace;
StartupNotify=true
StartupWMClass=antigravity-ide
DESKTOP

if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
fi

if [ "$is_update" = yes ]; then
	printf 'Updated Antigravity IDE (%s -> %s) at %s\n' "${installed_version:-previous}" "$version" "$install_path"
else
	printf 'Installed Antigravity IDE %s at %s\n' "$version" "$install_path"
fi

# -------------------------------------------------------------
# CLI global y alias 'agy-ide' (bash | zsh | fish)
# -------------------------------------------------------------
cli_binary="$install_path/bin/antigravity-ide"
[ -x "$cli_binary" ] || cli_binary="$command_link"
ln -sfn "$cli_binary" "$cli_link"

target_user="${SUDO_USER:-$USER}"
target_home=$(getent passwd "$target_user" 2>/dev/null | cut -d: -f6 || true)
if [ -z "$target_home" ] || [ ! -d "$target_home" ]; then
	target_home="${HOME:-/root}"
fi
login_shell=$(getent passwd "$target_user" 2>/dev/null | cut -d: -f7 || true)

# Prioridad: shell de login del usuario, luego $SHELL, luego archivos de configuración existentes
detected_shell=""
for candidate in "$(basename "${login_shell:-}")" "$(basename "${SHELL:-}")"; do
	case "$candidate" in
	*zsh*) detected_shell="zsh" ;;
	*fish*) detected_shell="fish" ;;
	*bash*) detected_shell="bash" ;;
	esac
	[ -n "$detected_shell" ] && break
done

if [ -z "$detected_shell" ]; then
	if [ -f "$target_home/.zshrc" ]; then
		detected_shell="zsh"
	elif [ -d "$target_home/.config/fish" ]; then
		detected_shell="fish"
	else
		detected_shell="bash"
	fi
fi

case "$detected_shell" in
zsh) config_file="$target_home/.zshrc" ;;
fish) config_file="$target_home/.config/fish/config.fish" ;;
*) config_file="$target_home/.bashrc" ;;
esac

alias_line="alias agy-ide='$cli_binary'"

mkdir -p "$(dirname "$config_file")"
if [ -f "$config_file" ] && grep -q '^alias agy-ide=' "$config_file"; then
	sed -i "s|^alias agy-ide=.*|$alias_line|" "$config_file"
else
	printf '\n# Alias para Antigravity IDE (funciona exactamente como "code")\n%s\n' "$alias_line" >>"$config_file"
fi

# Mantener la propiedad del usuario real (no root)
if [ -n "${SUDO_USER:-}" ] && [ "$target_user" != "root" ]; then
	target_group=$(id -gn "$target_user" 2>/dev/null || id -g "$target_user")
	chown "$target_user:$target_group" "$config_file"
	if [ "$detected_shell" = "fish" ]; then
		chown -R "$target_user:$target_group" "$target_home/.config/fish"
	fi
fi

printf 'Configured alias "agy-ide" for %s in %s\n' "$detected_shell" "$config_file"
